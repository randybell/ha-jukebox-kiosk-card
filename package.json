{
  "name": "ha-jukebox-card",
  "version": "0.5.1",
  "description": "Jukebox Card: kiosk jukebox card for Home Assistant + Music Assistant (Now Playing, Browse, Search, Queue, screensaver)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randybell/ha-jukebox-kiosk-card.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && node scripts/copy-fonts.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs && node test/unit/lyrics.unit.mjs && node test/lyrics.e2e.mjs && node test/unit/speakers.unit.mjs && node test/speakers.e2e.mjs",
    "perf": "node test/perf.mjs 3",
    "shots": "node test/shots-m2.mjs",
    "test:fit": "node test/fit.e2e.mjs"
  },
  "author": "Randy Bell",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "puppeteer-core": "^25.16.0",
    "rollup": "^4.67.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "music-assistant",
    "hacs",
    "jukebox"
  ]
}
